# Maintainer: Melker Halberd Pereira Alves <melker168@gmail.com>
pkgname=sddm-variant-manager
pkgver=2.2.0
pkgrel=1
pkgdesc="Browse, preview, apply, install, and remove SDDM login theme variants"
arch=('x86_64')
url="https://github.com/melker22/sddm-variant-manager"
license=('GPL-3.0-or-later')
depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-svg'
  'kirigami'
  'kcoreaddons'
  'ki18n'
  'karchive'
  # Freedesktop icons for Kirigami.Icon (list-add, view-refresh, …) on
  # Hyprland/Sway/i3 and other non-Plasma sessions without a full icon theme.
  'breeze-icons'
  'sddm'
  'polkit'
)
makedepends=(
  'cmake'
  'extra-cmake-modules'
  'ninja'
)
optdepends=(
  'ffmpeg: high-quality variant thumbnails from video backgrounds'
  'qt6-wayland: Wayland sessions (Hyprland, Sway, Plasma Wayland)'
  'qt6-5compat: older themes that need GraphicalEffects via Qt5Compat'
  'qt6-multimedia: video backgrounds in the real SDDM greeter'
)
source=("$pkgname-$pkgver.tar.gz")
# build-package.sh replaces this with the tarball checksum before makepkg.
sha256sums=('SKIP')

build() {
  cmake -B build -S "$pkgname-$pkgver" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
